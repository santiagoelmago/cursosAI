# PocketBase
PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=your-admin-password

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Twilio (use Sandbox number +14155238886 for dev)
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_WHATSAPP_FROM=+14155238886

# Cron security — a long random string to protect the send-messages endpoint
CRON_SECRET=change-this-to-a-long-random-string

# App URL (used for Stripe redirect URLs)
PUBLIC_APP_URL=http://localhost:5173
